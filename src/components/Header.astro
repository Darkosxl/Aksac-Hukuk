---
import { assets, firm, labels, localizedPath, otherLang, practiceAreas, teamMembers, t, type Lang } from "@data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = labels[lang];
const alternate = Astro.url.pathname.replace(/^\/(tr|en)(?=\/|$)/, `/${otherLang(lang)}`);
const altHref = alternate === Astro.url.pathname ? localizedPath(otherLang(lang)) : alternate;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={localizedPath(lang)} aria-label={firm.name[lang]}>
      <img src={assets.logo} alt={firm.name[lang]} width="237" height="86" />
    </a>

    <button class="menu-button" type="button" aria-label="Menu" aria-expanded="false" data-menu-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-nav" aria-label="Main navigation">
      <a href={localizedPath(lang)}>{copy.home}</a>
      <a href={localizedPath(lang, "about")}>{copy.aboutUs}</a>
      <div class="nav-dropdown">
        <a href={localizedPath(lang, "practice-areas")}>{copy.services}</a>
        <div class="dropdown-panel">
          {practiceAreas.map((area) => <a href={localizedPath(lang, `practice-areas/${area.slug}`)}>{t(area.title, lang)}</a>)}
        </div>
      </div>
      <div class="nav-dropdown">
        <a href={localizedPath(lang, "team")}>{copy.lawyers}</a>
        <div class="dropdown-panel">
          {teamMembers.map((member) => <a href={localizedPath(lang, `team/${member.slug}`)}>{member.name}</a>)}
        </div>
      </div>
      <a href={localizedPath(lang, "publications")}>{copy.publications}</a>
      <a href={localizedPath(lang, "contact")}>{copy.contact}</a>
    </nav>

    <div class="header-actions">
      <button class="icon-button" type="button" aria-label={copy.search} data-search-open>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16.5 16.5 4 4"></path>
        </svg>
      </button>
      <a class="language-link" href={altHref}>{lang === "tr" ? "EN" : "TR"}</a>
    </div>
  </div>

  <div class="search-panel" role="dialog" aria-label={copy.search}>
    <button class="search-close" type="button" aria-label="Close search" data-search-close></button>
    <form class="search-form" action={localizedPath(lang, "practice-areas")}>
      <label for="search-input">{copy.search}</label>
      <input id="search-input" name="q" type="search" data-search-input />
      <p>{lang === "tr" ? "Arama şu anda çalışma alanlarına yönlendirir." : "Search currently routes to practice areas."}</p>
    </form>
  </div>
</header>
