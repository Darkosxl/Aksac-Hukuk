---
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articles, languages, t, type Lang } from "@data/site";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    articles.map((article) => ({
      params: { lang, slug: article.slug },
      props: { article }
    }))
  );
}

const lang = Astro.params.lang as Lang;
const { article } = Astro.props;
const date = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(article.date));
---

<BaseLayout lang={lang} title={t(article.title, lang)} description={t(article.summary, lang)}>
  <PageHero lang={lang} title={t(article.title, lang)} text={`${t(article.category, lang)} · ${date} · ${article.author}`} />
  <section class="section-shell article-detail">
    <img src={article.image} alt="" loading="lazy" />
    <p class="lead">{t(article.summary, lang)}</p>
    {lang === "en" && <p class="article-note">This article is shown in its original Turkish text.</p>}
    {article.body.map((paragraph: string) => <p>{paragraph}</p>)}
    <a class="source-link" href={article.sourceUrl} target="_blank" rel="noreferrer">
      {lang === "tr" ? "Orijinal yayını görüntüle" : "View original publication"}
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
