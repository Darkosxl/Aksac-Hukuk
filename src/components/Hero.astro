---
import { heroSlides, labels, localizedPath, t, type Lang } from "@data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = labels[lang];
---

<section class="hero" data-hero aria-label="Featured content">
  <div class="hero-slides">
    {heroSlides.map((slide, index) => (
      <article class={`hero-slide ${index === 0 ? "is-active" : ""}`} data-hero-slide aria-hidden={index === 0 ? "false" : "true"}>
        <div class="hero-image" style={`background-image: url('${slide.image}')`}></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <h1>{t(slide.title, lang)}</h1>
          <p>{t(slide.text, lang)}</p>
          <a class="outline-button light" href={localizedPath(lang, slide.href)}>{t(slide.cta, lang)}</a>
        </div>
      </article>
    ))}
  </div>
  <button class="hero-arrow prev" type="button" aria-label="Previous slide" data-hero-prev>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
  </button>
  <button class="hero-arrow next" type="button" aria-label="Next slide" data-hero-next>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
  </button>
  <div class="hero-dots" role="tablist" aria-label="Hero slides">
    {heroSlides.map((_, index) => (
      <button type="button" class={index === 0 ? "is-active" : ""} aria-label={`${copy.readMore} ${index + 1}`} data-hero-dot></button>
    ))}
  </div>
</section>
