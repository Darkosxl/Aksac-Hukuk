---
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { about, assets, firm, labels, languages, practiceAreas, t, type Lang } from "@data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const copy = labels[lang];
---

<BaseLayout lang={lang} title={copy.aboutUs} description={t(about.intro, lang)}>
  <PageHero lang={lang} title={copy.aboutUs} text={t(about.intro, lang)} />

  <section class="section-shell two-column deep-copy">
    <div>
      <p class="eyebrow">{firm.founded}</p>
      <h2>{t(about.heading, lang)}</h2>
      <p class="lead">{t(about.intro, lang)}</p>
      {about.paragraphs.map((paragraph) => <p>{t(paragraph, lang)}</p>)}
    </div>
    <figure class="portrait-card offset">
      <img src={assets.realEstate} alt="" loading="lazy" />
    </figure>
  </section>

  <section class="quote-section">
    <div class="section-shell">
      <blockquote>
        {lang === "tr"
          ? "Görevimizi yaparken kimseye, ne müvekkile, ne hakime, hele ne iktidara tabiyiz."
          : "In performing our duty, we are subordinate to no one: neither client, nor judge, nor authority."}
      </blockquote>
      <cite>Moliere Jean-Baptiste Poquelin</cite>
    </div>
  </section>

  <section class="section-shell founder-section">
    <div>
      <p class="eyebrow">{lang === "tr" ? "Kurucumuzun Mesajı" : "Founder's Message"}</p>
      <h2>{t(about.founderMessage, lang)}</h2>
      <p>
        {lang === "tr"
          ? "Güçlü altyapımız, uzmanlaşmış dinamik kadromuz ve çağdaş yönetim biçimimizle daha büyük hukuki sorunların üstesinden geleceğimize inanıyoruz."
          : "With strong infrastructure, a specialized dynamic team and a contemporary management approach, we believe we can handle increasingly complex legal matters."}
      </p>
    </div>
    <div class="stat-grid">
      <div><strong>2007</strong><span>{lang === "tr" ? "Kuruluş" : "Founded"}</span></div>
      <div><strong>9</strong><span>{copy.services}</span></div>
      <div><strong>5</strong><span>{copy.lawyers}</span></div>
      <div><strong>{practiceAreas.length}</strong><span>{lang === "tr" ? "Odak Alan" : "Focus Areas"}</span></div>
    </div>
  </section>
</BaseLayout>
