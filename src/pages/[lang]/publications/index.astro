---
import ArticleCard from "@components/ArticleCard.astro";
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { articles, labels, languages, type Lang } from "@data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const copy = labels[lang];
const categories = ["all", ...new Set(articles.map((article) => article.category[lang]))];
---

<BaseLayout lang={lang} title={copy.publications}>
  <PageHero lang={lang} title={copy.publicationsHeading} text={lang === "tr" ? "Aksaç çalışma alanlarından seçilmiş yazılar" : "Selected notes from Aksaç practice areas"} />
  <section class="section-shell" data-filter-group>
    <div class="filter-tabs">
      {categories.map((category, index) => (
        <button type="button" class={index === 0 ? "is-active" : ""} data-filter={category}>
          {category === "all" ? (lang === "tr" ? "Tümü" : "All") : category}
        </button>
      ))}
    </div>
    <div class="article-grid">
      {articles.map((article) => <ArticleCard lang={lang} article={article} />)}
    </div>
  </section>
</BaseLayout>
