---
import PageHero from "@components/PageHero.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { labels, languages, localizedPath, teamMembers, t, type Lang } from "@data/site";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    teamMembers.map((member) => ({
      params: { lang, slug: member.slug },
      props: { member }
    }))
  );
}

const lang = Astro.params.lang as Lang;
const { member } = Astro.props;
const copy = labels[lang];
---

<BaseLayout lang={lang} title={member.name}>
  <PageHero lang={lang} title={member.name} text={t(member.role, lang)} />
  <section class="section-shell profile-layout">
    <figure class="profile-photo">
      <img src={member.image} alt={member.name} loading="lazy" />
    </figure>
    <article class="detail-copy">
      <p class="eyebrow">{t(member.role, lang)}</p>
      <h2>{member.name}</h2>
      {member.bio.map((paragraph) => <p>{t(paragraph, lang)}</p>)}
      <h3>{lang === "tr" ? "Odak Alanlar" : "Focus Areas"}</h3>
      <ul class="pill-list">
        {member.specialties.map((item) => <li>{t(item, lang)}</li>)}
      </ul>
      <a class="gold-button" href={localizedPath(lang, "contact")}>{copy.contactUs}</a>
    </article>
  </section>
</BaseLayout>
