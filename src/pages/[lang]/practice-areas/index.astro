---
import PageHero from "@components/PageHero.astro";
import PracticeCard from "@components/PracticeCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { labels, languages, practiceAreas, type Lang } from "@data/site";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const copy = labels[lang];
---

<BaseLayout lang={lang} title={copy.services}>
  <PageHero lang={lang} title={copy.servicesHeading} text={copy.practiceIntro} />
  <section class="section-shell practice-list">
    <div class="practice-grid large">
      {practiceAreas.map((area) => <PracticeCard lang={lang} area={area} />)}
    </div>
  </section>
</BaseLayout>
